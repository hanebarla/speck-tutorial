Bootstrap: docker
From: ubuntu:24.04

%labels
    org.opencontainers.image.title Speck development environment
    org.opencontainers.image.description Sinabs and Samna environment for SynSense Speck devices
    org.opencontainers.image.version 2026.08
    org.opencontainers.image.source https://github.com/synsense/sinabs

%help
    Speck development environment containing Sinabs, Samna and CPU PyTorch.

    Build:
        apptainer build --fakeroot speck.sif speck.def

    Check Python packages:
        apptainer test speck.sif

    List connected SynSense devices:
        apptainer exec speck.sif \
            python -c 'import samna; print(samna.device.get_unopened_devices())'

    The host must have the SynSense udev rules installed. See README.md next to
    this definition file. Connect Speck with a USB 3 cable to a USB 3 port.

%environment
    export PATH="/opt/venv/bin:${PATH}"
    export PYTHONNOUSERSITE=1
    export PYTHONUNBUFFERED=1
    export QT_X11_NO_MITSHM=1

%post
    set -eu

    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        libgl1 \
        libglib2.0-0 \
        libglu1-mesa-dev \
        libsm6 \
        libusb-1.0-0 \
        libx11-xcb-dev \
        libxext6 \
        libxi-dev \
        libxinerama-dev \
        libxrandr-dev \
        libxrender1 \
        libxcursor-dev \
        libxcb-dri2-0-dev \
        libxcb-dri3-dev \
        libxcb-glx0-dev \
        libxcb-present-dev \
        libxcb-sync-dev \
        mesa-common-dev \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        usbutils

    python3 -m venv /opt/venv
    /opt/venv/bin/python -m pip install --no-cache-dir --upgrade \
        pip==26.1.1 \
        setuptools==80.9.0 \
        wheel==0.46.1

    # A CPU wheel is sufficient for compiling and deploying networks to Speck,
    # and avoids pulling several gigabytes of unused CUDA libraries.
    /opt/venv/bin/python -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.8.0+cpu

    # Install the native Samna wheel directly. The package on PyPI is a small
    # shim that downloads/replaces itself on first import, which cannot work
    # reliably once this image has become a read-only SIF file.
    /opt/venv/bin/python -m pip install --no-cache-dir \
        --index-url https://gitlab.com/api/v4/projects/27423070/packages/pypi/simple \
        samna==0.48.6

    /opt/venv/bin/python -m pip install --no-cache-dir \
        sinabs==3.1.3 \
        opencv-python-headless==5.0.0.93 \
        'jupyterlab>=4,<5' \
        'ipywidgets>=8,<9'

    apt-get clean
    rm -rf /var/lib/apt/lists/* /root/.cache/pip

%test
    set -eu
    /opt/venv/bin/python - <<'PY'
from importlib.metadata import version

import samna
import sinabs
import torch
import cv2
from sinabs.backend.dynapcnn import DynapcnnNetwork

assert hasattr(samna, "device")
assert DynapcnnNetwork is not None
print(f"torch={version('torch')}")
print(f"sinabs={version('sinabs')}")
print(f"samna={version('samna')}")
print(f"opencv-python-headless={version('opencv-python-headless')}")
print("Speck Python environment: OK")
PY

%runscript
    if [ "$#" -eq 0 ]; then
        exec /bin/bash
    fi
    exec /opt/venv/bin/python "$@"
