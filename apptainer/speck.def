Bootstrap: docker
From: ubuntu:24.04

%labels
    org.opencontainers.image.title Speck development environment
    org.opencontainers.image.description Sinabs, Samna and CUDA PyTorch environment for SynSense Speck devices
    org.opencontainers.image.version 2026.09
    org.opencontainers.image.source https://github.com/synsense/sinabs

%help
    Speck development environment containing Sinabs, Samna and CUDA 12.8 PyTorch.

    Build:
        apptainer build --fakeroot speck.sif speck.def

    Check Python packages:
        apptainer test speck.sif

    Check GPU computation (requires an NVIDIA GPU and host driver):
        apptainer test --nv --env SPECK_REQUIRE_CUDA=1 speck.sif

    Start a GPU-enabled shell:
        apptainer shell --nv speck.sif

    List connected SynSense devices:
        apptainer exec speck.sif \
            python -c 'import samna; print(samna.device.get_unopened_devices())'

    The host must have the SynSense udev rules installed. See README.md next to
    this definition file. Connect Speck with a USB 3 cable to a USB 3 port.

%environment
    export PATH="/opt/venv/bin:${PATH}"
    export PYTHONNOUSERSITE=1
    export PYTHONUNBUFFERED=1
    export QT_X11_NO_MITSHM=1

%post
    set -eu

    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        libgl1 \
        libglib2.0-0 \
        libglu1-mesa-dev \
        libsm6 \
        libusb-1.0-0 \
        libx11-xcb-dev \
        libxext6 \
        libxi-dev \
        libxinerama-dev \
        libxrandr-dev \
        libxrender1 \
        libxcursor-dev \
        libxcb-dri2-0-dev \
        libxcb-dri3-dev \
        libxcb-glx0-dev \
        libxcb-present-dev \
        libxcb-sync-dev \
        mesa-common-dev \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        usbutils

    python3 -m venv /opt/venv
    /opt/venv/bin/python -m pip install --no-cache-dir --upgrade \
        pip==26.1.1 \
        setuptools==80.9.0 \
        wheel==0.46.1

    # CUDA 12.8 wheels support Blackwell GPUs, including RTX PRO 4000.
    # Keep the tested PyTorch version; CUDA runtime libraries come from pip.
    # The NVIDIA driver is supplied by the host via apptainer --nv at runtime.
    /opt/venv/bin/python -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.8.0+cu128

    # Install the native Samna wheel directly. The package on PyPI is a small
    # shim that downloads/replaces itself on first import, which cannot work
    # reliably once this image has become a read-only SIF file.
    /opt/venv/bin/python -m pip install --no-cache-dir \
        --index-url https://gitlab.com/api/v4/projects/27423070/packages/pypi/simple \
        samna==0.48.6

    # Tonic 1.6 requires NumPy < 2; OpenCV 4.11 supports the same NumPy version.
    # build-essential above is needed to compile Tonic's expelliarmus dependency.
    /opt/venv/bin/python -m pip install --no-cache-dir \
        sinabs==3.1.3 \
        numpy==1.26.4 \
        opencv-python-headless==4.11.0.86 \
        tonic==1.6.0 \
        'tqdm>=4.66,<5' \
        'jupyterlab>=4,<5' \
        'ipywidgets>=8,<9'

    apt-get clean
    rm -rf /var/lib/apt/lists/* /root/.cache/pip

%test
    set -eu
    /opt/venv/bin/python -m pip check
    /opt/venv/bin/python - <<'PY'
from importlib.metadata import version
import os

import samna
import sinabs
import torch
import cv2
import tonic
import tqdm
from sinabs.backend.dynapcnn import DynapcnnNetwork

assert hasattr(samna, "device")
assert DynapcnnNetwork is not None
assert torch.version.cuda == "12.8", "Expected the CUDA 12.8 PyTorch build"
print(f"torch={version('torch')}")
print(f"torch CUDA={torch.version.cuda}")
print(f"sinabs={version('sinabs')}")
print(f"samna={version('samna')}")
print(f"opencv-python-headless={version('opencv-python-headless')}")
print(f"tonic={version('tonic')}")
print(f"tqdm={version('tqdm')}")
assert tonic.transforms.ToFrame(sensor_size=(34, 34, 2), n_time_bins=1) is not None
cuda_available = torch.cuda.is_available()
print(f"CUDA available={cuda_available}")
if os.environ.get("SPECK_REQUIRE_CUDA") == "1":
    assert cuda_available, "GPU is unavailable: use --nv and check the host NVIDIA driver"
if cuda_available:
    # Exercise CUDA/cuDNN and Sinabs backward, not just device discovery.
    model = torch.nn.Sequential(
        torch.nn.Conv2d(2, 4, 3, bias=False),
        sinabs.layers.IAFSqueeze(batch_size=1, min_v_mem=-1.0),
    ).cuda()
    x = torch.randn(2, 2, 34, 34, device="cuda", requires_grad=True)
    loss = model(x).square().mean()
    loss.backward()
    torch.cuda.synchronize()
    assert torch.isfinite(loss).item()
    assert x.grad is not None and torch.isfinite(x.grad).all().item()
    assert model[0].weight.grad is not None
    assert torch.isfinite(model[0].weight.grad).all().item()
    print(f"GPU computation: OK ({torch.cuda.get_device_name(0)})")
else:
    print("GPU computation: skipped (run test --nv with SPECK_REQUIRE_CUDA=1 to require it)")
print("Speck Python environment: OK")
PY

%runscript
    if [ "$#" -eq 0 ]; then
        exec /bin/bash
    fi
    exec /opt/venv/bin/python "$@"
